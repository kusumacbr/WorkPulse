# WorkPulse Environment Variables

# App URL & Domain
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_DOMAIN="localhost"

# Better Auth Secret & Base URL
BETTER_AUTH_SECRET="workpulse-secure-secret-key-phase-0-foundation-xorstack"
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth (@xorstack.com restriction)
GOOGLE_CLIENT_ID="mock-google-client-id"
GOOGLE_CLIENT_SECRET="mock-google-client-secret"

# PostgreSQL Database URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/workpulse?schema=public"
